{
    "name": "siberfx/typesense-scout",
    "description": "Laravel Scout Driver for Typesense",
    "keywords": [
        "laravel",
        "scout",
        "typesense",
        "search",
        "vector-search"
    ],
    "type": "library",
    "homepage": "https://github.com/siberfx/typesense-scout",
    "support": {
        "issues": "https://github.com/siberfx/typesense-scout/issues",
        "source": "https://github.com/siberfx/typesense-scout"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com",
            "homepage": "https://siberfx.com",
            "role": "Software Engineer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Siberfx\\Typesense\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\Typesense\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\Typesense\\TypesenseServiceProvider"
            ],
            "aliases": {
                "Typesense": "Siberfx\\Typesense\\TypesenseFacade",
                "TypesenseDirect": "Siberfx\\Typesense\\Standalone\\TypesenseStandaloneFacade"
            }
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/scout": "^11.9",
        "illuminate/bus": "^12.69|^13.30",
        "illuminate/contracts": "^12.69|^13.30",
        "illuminate/database": "^12.69|^13.30",
        "illuminate/pagination": "^12.69|^13.30",
        "illuminate/queue": "^12.69|^13.30",
        "illuminate/support": "^12.69|^13.30",
        "typesense/typesense-php": "^6.0",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0|^13.4",
        "vlucas/phpdotenv": "^5.7",
        "phpstan/phpstan": "^2.1",
        "pestphp/pest": "^4.7.8"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --testsuite Unit",
        "test:integration": "pest --testsuite Integration",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "suggest": {
        "laravel/ai": "Required to generate embeddings for semantic() / hybrid() searches (embedding driver laravel-ai)."
    }
}
